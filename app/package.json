{
  "name": "morpher91",
  "private": true,
  "version": "0.1.16",
  "description": "A WebGPU & WebCodecs studio for 2D image and video morphing.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreFrelicot/morpher91.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/AndreFrelicot/morpher91/issues"
  },
  "homepage": "https://github.com/AndreFrelicot/morpher91#readme",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/bump-version.mjs && tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "pwa:assets": "node scripts/generate-pwa-assets.mjs",
    "licenses:generate": "node scripts/generate-license-notices.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "delaunator": "^5.1.0",
    "fflate": "^0.8.3",
    "i18next": "^26.3.6",
    "immer": "^11.1.8",
    "lucide-react": "^1.17.0",
    "mediabunny": "^1.45.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/delaunator": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@webgpu/types": "^0.1.70",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
